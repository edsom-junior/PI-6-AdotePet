{
  "compilerOptions": {
    "module": "Node16",
    "target": "es2020",
    "moduleResolution": "Node16",
    "types": ["node"],
    "sourceMap": true,
    "declaration": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "prisma.config.ts",
    "src/prisma/db.ts"
  ]
}